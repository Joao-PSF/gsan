# Versões fixadas do ambiente de referência do GSAN legado (Fase 1).
#
# Tudo o que o ambiente baixa ou executa está aqui, com identificador imutável
# (commit, checksum publicado ou digest). Mudar uma linha deste arquivo muda a
# referência: registre o motivo no documento do ambiente antes de alterar.
#
# Este arquivo é lido pelo docker compose (--env-file) e pelos scripts.
# Não contém segredo.

# --- Código legado de referência -------------------------------------------
# Último commit que altera o código do GSAN (2023-10-10). Os commits seguintes
# só acrescentam documentação e este ambiente; `referencia.sh build` confere.
GSAN_COMMIT_LEGADO=1a0edcfc6ff28ec7c97b8fc64ec75712789a9415

# --- Banco: migrações MyBatis do GSAN ---------------------------------------
GSAN_MIGRACOES_REPO=https://github.com/Joao-PSF/gsan-migracoes.git
GSAN_MIGRACOES_COMMIT=2d6acdb9859efe06aeb6e2d51c7ef815ddcdf679

# --- Receita oficial de instalação (Prodiga Sistemas) ------------------------
# Scripts de instalação citados pela wiki do GSAN: JBoss, datasource, locale.
PRODIGA_TI_REPO=https://github.com/prodigasistemas/ti.git
PRODIGA_TI_COMMIT=75b1a2f6cab9ad2faa71e1bb511a6f2c036af9bc
# Bibliotecas que a receita copia para dentro do JBoss (Hibernate 3, web, DTD).
JBOSS_LIBS_REPO=https://github.com/prodigasistemas/jboss-libs.git
JBOSS_LIBS_COMMIT=3002fa148a4f311c21f310cccb8884f23d2d9098

# --- Binários -----------------------------------------------------------------
# SHA-1 publicado pelo SourceForge na página do projeto JBoss.
JBOSS_URL=https://downloads.sourceforge.net/project/jboss/JBoss/JBoss-4.0.1SP1/jboss-4.0.1sp1.zip
JBOSS_SHA1=f6244a11c96ed2db7673d7342e5c22073cfadf06
# JDK 6: Azul Zulu 6 (OpenJDK 6u119, build certificado). SHA-256 publicado pela Azul
# (api.azul.com/metadata/v1/zulu/packages). A receita usa Oracle JDK 6, não redistribuível; o
# OpenJDK 6 do Debian wheezy (openjdk:6b38-jdk) foi descartado: a glibc 2.13 chama time() pela
# página vsyscall e a JVM morre (SIGSEGV em 0xffffffffff600400) em kernels sem emulação de
# vsyscall, como o do Docker Desktop/WSL2. Ver o documento do ambiente.
JDK6_URL=https://cdn.azul.com/zulu/bin/zulu6.22.0.3-ca-jdk6.0.119-linux_x64.tar.gz
JDK6_SHA256=dd4765b45d9f1fc319a6e5be0bbc79371582daa8fd77872d51072f16deca2625
# SHA-512 publicado pela Apache ao lado do arquivo.
ANT_URL=https://archive.apache.org/dist/ant/binaries/apache-ant-1.9.16-bin.tar.gz
ANT_SHA512=8d542a7a636a491e76170148881b6f413f4564aad1ab034f426bd946be93382001862bd6c60865aa2b57b39b9633e0181fe8997dd6323123aaf76b410ec4a366

# --- Imagens base (Docker Hub, imagens oficiais) ------------------------------
# Tag para leitura, digest da manifest list (multiarquitetura) para reprodução: a tag
# pode ser republicada, o digest não.
# Base do servidor de aplicação (JDK 6 + JBoss + Ant): glibc moderna, com vDSO.
IMG_DEBIAN=debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
IMG_POSTGRES=postgres:9.5.25@sha256:75ebf479151a8fd77bf2fed46ef76ce8d518c23264734c48f2d1de42b4eb40ae
IMG_NGINX=nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10
IMG_ALPINE=alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc
