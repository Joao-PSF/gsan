{
  "dominio": "cobranca",
  "lote": "batch-cobranca",
  "modo": "Batch",
  "fronteira": "Efetuar Parcelamento de Débitos pela tela (exibirEfetuarParcelamentoDebitosAction → EfetuarParcelamentoDebitosWizardAction, assistente em quatro passos: o imóvel, a RD e as perguntas; os débitos; as opções de prestações — Fachada.obterOpcoesDeParcelamento —; a confirmação; Concluir → Fachada.concluirParcelamentoDebitos), no EAR em modo Batch, sobre a conta de 05/2026 que o faturamento em grupo gera no início da execução (com a referência de faturamento avançada a 06/2026 pelo passo da massa — a conta da referência corrente não entra no parcelamento), o débito a cobrar de serviço restante, a guia de pagamento da massa e os acréscimos por impontualidade (índices do lote 7). A posição antes e depois pela tela Consultar Débitos; o parcelamento (cabeçalho, itens, guia de entrada, contadores do imóvel) e os débitos e créditos gerados lidos do banco.",
  "roteiro": "faturar_grupo",
  "autenticacao": "roteiro",
  "usuarios": {
    "fase2.oper": "senha-operador"
  },
  "precondicoes": [
    {
      "descricao": "tarifa por CATEGORIA (sistema_parametros.parm_ictarifacategoria = 1)",
      "sql": "select parm_ictarifacategoria from cadastro.sistema_parametros",
      "esperado": "1"
    },
    {
      "descricao": "relógio: nenhuma vigência de tarifa posterior à data do banco (o mínimo da ligação usa a vigência em vigor HOJE)",
      "sql": "select (max(cstv_dtvigencia) <= current_date)::text from faturamento.consumo_tarifa_vigencia",
      "esperado": "true"
    },
    {
      "descricao": "relógio: as datas dos arquivos (pagamento até 20/06/2026, crédito e geração até 22/06/2026) não são posteriores à data do banco — a recepção recusa pagamento com data futura",
      "sql": "select (current_date >= date '2026-06-22')::text",
      "esperado": "true"
    },
    {
      "descricao": "o grupo G1 está na referência do comando (05/2026) e o comando não foi realizado",
      "sql": "select g.ftgr_amreferencia::text || '/' || (c.ftac_tmrealizacao is null)::text from faturamento.faturamento_grupo g, faturamento.fatur_ativ_cronograma c where g.ftgr_id = 1 and c.ftac_id = 1",
      "esperado": "202605/true"
    },
    {
      "descricao": "referências do sistema: faturamento 05/2026 (o passo de encerramento a avança) e arrecadação 06/2026",
      "sql": "select parm_amreferenciafaturamento::text || '/' || parm_amreferenciaarrecadacao::text from cadastro.sistema_parametros",
      "esperado": "202605/202606"
    },
    {
      "descricao": "empresa FEBRABAN 0901 e layout 04; o contrato do arrecadador 901 espera o NSA 1",
      "sql": "select p.parm_cdempresafebraban::text || '/' || p.parm_nnlayoutfebraban::text || '/' || c.arct_nnnsaretornocdbarras::text from cadastro.sistema_parametros p, arrecadacao.arrecadador_contrato c where c.arct_id = 901",
      "esperado": "901/4/0"
    },
    {
      "descricao": "relógio: a data do banco é posterior em mais de 31 dias ao vencimento das contas (10/06/2026) — os juros diários da massa atingem o teto (1,00%) e o acréscimo de uma conta não paga deixa de depender do dia",
      "sql": "select (current_date >= date '2026-07-11')::text",
      "esperado": "true"
    }
  ],
