# Configuração por ambiente do GSAN de referência.
# Copie para `.env` (ignorado pelo Git) e preencha. `referencia.sh preparar`
# gera as senhas se estiverem vazias.

# --- Segredos locais (nunca versionar) ---------------------------------------
# Senha do superusuário do PostgreSQL de referência. Também é a credencial do
# datasource do JBoss, como na receita oficial (ver documento do ambiente).
GSAN_DB_SENHA=
# Senha do usuário `admin` do GSAN de referência. Substitui a senha padrão
# publicada pelas migrations e pela wiki, que é considerada comprometida.
GSAN_ADMIN_SENHA=

# --- Build ---------------------------------------------------------------------
# Online | Batch. Batch inicializa o agendador Quartz (verificador de processos
# a cada minuto), sem o qual processos batch e relatórios assíncronos não rodam.
GSAN_TIPO=Online
# Texto gravado no rodapé das telas pelo build.xml (alvo alterarDataVersao).
GSAN_VERSAO=referencia

# --- Execução ------------------------------------------------------------------
# Porta HTTP publicada somente em 127.0.0.1.
GSAN_PORTA_HTTP=8080
# Memória da JVM do JBoss (valores da receita oficial).
GSAN_JVM_XMS=512m
GSAN_JVM_XMX=1024m
GSAN_JVM_MAXPERM=512m

# --- Banco ---------------------------------------------------------------------
# detectar | latin1. `detectar` lê cada script de migração na codificação em que
# foi gravado (UTF-8 quando válido, senão LATIN1). `latin1` reproduz a receita
# oficial (script_char_set=LATIN1 para todos), que grava texto corrompido nos
# scripts em UTF-8.
GSAN_MIGRACOES_CODIFICACAO=detectar
# Variante de companhia (cadastro.sistema_parametros.parm_nmcontrolador).
# Vazio mantém o valor semeado pelas migrations. A escolha da variante da
# baseline é decisão da Fase 2.
GSAN_VARIANTE=

# --- Acesso remoto temporário (opcional; ver README "Acesso remoto temporário") -------------------
# E-mails (ou *@dominio) autorizados no Quick Tunnel protegido, separados por vírgula. Vazio:
# `referencia.sh compartilhar` recusa abrir o túnel. Valor local — nunca versionar.
CLOUDFLARED_ALLOWED_EMAILS=
# Porta local (só 127.0.0.1) da instância de INSPEÇÃO, separada da instância das baselines.
GSAN_INSPECAO_PORTA_HTTP=8090
